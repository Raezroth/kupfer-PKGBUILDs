)

pkgver() {
    cd $pkgname
    git describe --long --tags --abbrev=7 "$_commit" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}


package() {
    cd $pkgname
    make DESTDIR="$pkgdir" install
}
